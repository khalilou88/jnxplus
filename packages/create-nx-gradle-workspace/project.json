{
  "name": "create-nx-gradle-workspace",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/create-nx-gradle-workspace/bin",
  "projectType": "library",
  "tags": [],
  "implicitDependencies": ["nx-gradle"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
