{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "workspaceLayout": {
    "libsDir": "packages",
    "appsDir": "testing-projects"
  },
  "targetDefaults": {
    "nx-release-publish": {
      "dependsOn": ["build"],
      "options": {
        "packageRoot": "dist/packages/{projectName}"
      }
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "test": [
      {
        "filter": {
          "plugin": "@nx/jest/plugin"
        },
        "configurations": {
          "ci": {
            "ci": true,
            "coverage": true
          }
        },
        "options": {
          "passWithNoTests": true
        }
      }
    ],
    "lint": [
      {
        "filter": {
          "plugin": "@nx/eslint/plugin"
        },
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/.eslintrc.json",
          "{workspaceRoot}/.eslintignore",
          "{workspaceRoot}/eslint.config.js",
          "{workspaceRoot}/tools/eslint-rules/**/*",
          {
            "externalDependencies": ["eslint"]
          }
        ]
      }
    ]
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.js",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "sharedGlobals": []
  },
  "release": {
    "projects": [
      "common",
      "xml",
      "nx-gradle",
      "create-nx-gradle-workspace",
      "nx-maven",
      "create-nx-maven-workspace"
    ],
    "projectsRelationship": "fixed",
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github"
      }
    }
  },
  "parallel": 1,
  "defaultBase": "main",
  "analytics": false,
  "neverConnectToCloud": true,
  "affected": {
    "legacy": true
  },
  "plugins": [
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "include": [
        "packages/common/**/*",
        "packages/create-nx-gradle-workspace/**/*",
        "packages/create-nx-maven-workspace/**/*",
        "packages/internal/executors/**/*",
        "packages/internal/testing/**/*",
        "packages/nx-gradle/**/*",
        "packages/nx-maven/**/*",
        "packages/xml/**/*"
      ]
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "e2e"
      },
      "include": ["testing-projects/jnxplus-e2e/**/*"]
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "smoke"
      },
      "include": ["testing-projects/jnxplus-smoke/**/*"]
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "smoke-affected"
      },
      "include": ["testing-projects/jnxplus-smoke-affected/**/*"]
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "smoke-next"
      },
      "include": ["testing-projects/jnxplus-smoke-next/**/*"]
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": [
        "packages/common/**/*",
        "packages/create-nx-gradle-workspace/**/*",
        "packages/create-nx-maven-workspace/**/*",
        "packages/internal/executors/**/*",
        "packages/internal/testing/**/*",
        "packages/nx-gradle/**/*",
        "packages/nx-maven/**/*",
        "packages/xml/**/*",
        "testing-projects/jnxplus-e2e/**/*",
        "testing-projects/jnxplus-smoke/**/*",
        "testing-projects/jnxplus-smoke-affected/**/*",
        "testing-projects/jnxplus-smoke-next/**/*"
      ]
    }
  ]
}
